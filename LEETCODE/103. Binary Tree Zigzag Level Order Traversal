class Solution {
public:
    vector<vector<int>> zigzagLevelOrder(TreeNode* root) {
        vector<vector<int>> res;
        if(!root) return res;

        queue<TreeNode*> q;
        q.push(root);
        int level = 0;
         while (!q.empty()){
            int sz = q.size();
            deque<int> levelDeque;

            for (int i = 0; i < sz; ++i){
                TreeNode* node = q.front(); q.pop();

                if (level % 2 == 0) 
                  levelDeque.push_back(node->val);
                else  levelDeque.push_front(node->val);

                if (node->left) q.push(node->left);
                if (node->right) q.push(node->right);
          }
            res.emplace_back(vector<int>(levelDeque.begin(), levelDeque.end()));
            ++level;
        }
        return res;
    }
};
