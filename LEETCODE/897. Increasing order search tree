class Solution {
public:
     TreeNode* increasingBST(TreeNode* root) {
       TreeNode* dummy = new TreeNode(0);
       TreeNode* tail = dummy;

      
        function<void(TreeNode*)> traverse = [&](TreeNode* node) {
            if (!node) return;
            traverse(node->left);

            node->left = nullptr;
            tail->right = node;
            tail = node;

            traverse(node->right);
        };

        traverse(root);
        return dummy->right;
    }
};
