class Solution {
public:
    bool uniqueOccurrences(vector<int>& arr) {

        int freq[2001] = {0};

        // frequency count
        for(int i = 0; i < arr.size(); i++) {
            freq[arr[i] + 1000]++;
        }

        bool used[1001] = {0};

        // check duplicate frequencies
        for(int i = 0; i < 2001; i++) {

            if(freq[i] > 0) {

                if(used[freq[i]] == true) {
                    return false;
                }

                used[freq[i]] = true;
            }
        }

        return true;
    }
};
